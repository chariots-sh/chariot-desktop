#cloud-config
hostname: chariot-sandbox
manage_etc_hosts: true

users:
  - name: agent
    gecos: Chariot Agent
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__

write_files:
  - path: /opt/chariot/bridge.py
    permissions: "0755"
    encoding: b64
    content: __BRIDGE_B64__
  - path: /etc/systemd/system/chariot-bridge.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Chariot guest bridge (vsock)
      After=network.target

      [Service]
      ExecStartPre=-/sbin/modprobe virtio_vsock
      ExecStart=/usr/bin/python3 /opt/chariot/bridge.py
      Restart=always
      RestartSec=2

      [Install]
      WantedBy=multi-user.target
  - path: /etc/ssh/sshd_config.d/chariot.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      AllowAgentForwarding no
      X11Forwarding no
      AllowTcpForwarding no
  - path: /etc/systemd/network/10-chariot.network
    permissions: "0644"
    content: |
      [Match]
      Name=en*

      [Network]
      DHCP=yes

runcmd:
  - mkdir -p /workspace
  - chown agent:agent /workspace
  # Persistent NIC management — survives reboots regardless of cloud-init's
  # first-boot-only network rendering.
  - systemctl enable --now systemd-networkd systemd-resolved || true
  # Preinstall the Codex CLI runtime (bridge self-heals if this fails).
  #
  # Both binaries, not just `codex`: bridge.py's codex_installed() requires
  # every entry in CODEX_BINARIES, so installing one left the agent reporting
  # installed=false after a successful boot — which in turn disabled the
  # Sign in Codex button, whose only alternative trigger for the self-heal was
  # a chat turn the user could not usefully send yet.
  - |
    for pair in "codex-aarch64-unknown-linux-musl:/usr/local/bin/codex" \
                "codex-code-mode-host-aarch64-unknown-linux-musl:/usr/local/bin/codex-code-mode-host"; do
      asset="${pair%%:*}"
      dest="${pair##*:}"
      curl -fsSL -o "/tmp/$asset.tar.gz" \
        "https://github.com/openai/codex/releases/download/rust-v0.147.0/$asset.tar.gz" \
        && tar -xzf "/tmp/$asset.tar.gz" -C /tmp \
        && mv "/tmp/$asset" "$dest" \
        && chmod 755 "$dest" \
        && rm -f "/tmp/$asset.tar.gz" || true
    done
  - systemctl daemon-reload
  - systemctl enable --now chariot-bridge.service
  - systemctl restart ssh || systemctl restart sshd || true

final_message: "chariot guest ready after $UPTIME seconds"
