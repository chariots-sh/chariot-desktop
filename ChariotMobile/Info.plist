<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>ChariotMobile</string>
    <key>CFBundleIdentifier</key><string>dev.chariot.mobile</string>
    <key>CFBundleName</key><string>Chariot</string>
    <key>CFBundleDisplayName</key><string>Chariot</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>UILaunchScreen</key><dict/>
    <key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
    <key>NSCameraUsageDescription</key>
    <string>Chariot scans the pairing QR code displayed by your Mac.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
        <!-- Narrow exception scoped to tailnet MagicDNS names: lets the app's
             pinned-key trust decision stand for the Mac's self-signed cert
             when the tailnet has HTTPS certificates disabled. iOS (26.6+)
             otherwise overrides the app's server-trust decision for
             non-exempt domains. Not a global exception; the SPKI pin in
             TransportSessionDelegate remains the trust boundary. -->
        <key>NSExceptionDomains</key>
        <dict>
            <key>ts.net</key>
            <dict>
                <key>NSIncludesSubdomains</key><true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
            </dict>
        </dict>
    </dict>
    <key>MinimumOSVersion</key><string>17.0</string>
</dict>
</plist>
